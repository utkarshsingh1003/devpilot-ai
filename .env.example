# ---------------------------------------------------------------------------
# DevPilot AI environment variables
# Copy this file to `.env.local` and fill in only what you need.
# NEVER prefix secrets with NEXT_PUBLIC_. That would expose them to the browser.
# ---------------------------------------------------------------------------

# Optional. A GitHub token raises the API rate limit (60 -> 5,000 requests/hour)
# and is required to analyze private repositories.
# Classic token scope: `public_repo` for public repos, `repo` for private repos.
# Fine-grained token: Repository contents = Read-only.
GITHUB_TOKEN=

# Optional. Enable AI-generated summaries and prioritization.
# The app works fully without this; deterministic analysis is always available.
AI_API_KEY=

# Optional. Any OpenAI-compatible chat-completions endpoint.
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (set AI_API_KEY=ollama)
AI_BASE_URL=https://api.openai.com/v1

# Optional. Model name supported by your provider.
AI_MODEL=gpt-4o-mini

# Optional. Used for canonical metadata/Open Graph URLs after deployment.
NEXT_PUBLIC_SITE_URL=
