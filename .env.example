# ---------------------------------------------------------------------------
# DevPilot AI environment variables
# Copy this file to `.env.local` and fill in only what you need.
# NEVER prefix secrets with NEXT_PUBLIC_. That would expose them to the browser.
# ---------------------------------------------------------------------------

# Optional. A GitHub token raises the API rate limit (60 -> 5,000 requests/hour)
# and is required to analyze private repositories.
# Classic token scope: `public_repo` for public repos, `repo` for private repos.
# Fine-grained token: Repository contents = Read-only.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# AI summaries (optional)
#
# ZERO-COST DEFAULT: Google Gemini Developer API free tier.
#
# 1. Create a key at https://aistudio.google.com/apikey
# 2. Set GEMINI_API_KEY below.
#
# Use a Google Cloud project WITHOUT a billing account to stay on the free tier.
# DevPilot enforces the free profile in code: fixed Gemini Developer API
# endpoint, free-tier model allowlist, no tools/grounding, capped output tokens.
# It cannot inspect your project's billing state, so that part is your call.
#
# Free-tier prompts may be used to improve Google products. DevPilot sends
# finding metadata only, never source code.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional. Selects the provider explicitly. When unset, DevPilot uses Gemini if
# GEMINI_API_KEY is set, otherwise the generic OpenAI-compatible provider.
# Allowed: gemini | openai-compatible
# AI_PROVIDER=gemini

# Optional. Must stay unset (or exactly this value) for the Gemini zero-cost
# profile. Vertex AI and custom endpoints are rejected in Gemini mode.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional. Must be on the free-tier allowlist in `lib/ai-config.ts`.
# Allowed: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite,
#          gemini-3.1-flash-lite, gemini-2.5-flash, gemini-2.5-flash-lite
AI_MODEL=gemini-3.8-flash

# Optional. Caps generated output tokens (128-1024, default 512) to keep
# requests small and free-tier friendly.
AI_MAX_OUTPUT_TOKENS=512

# ---------------------------------------------------------------------------
# Alternative: any OpenAI-compatible endpoint (NOT zero-cost verified)
#
# Set AI_PROVIDER=openai-compatible plus AI_API_KEY and AI_BASE_URL.
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (set AI_API_KEY=ollama)
#
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------

# Optional. Used for canonical metadata/Open Graph URLs after deployment.
NEXT_PUBLIC_SITE_URL=
